# Self-evolving medical agent image (x86_64).
#
# Target: H100/H200 (mib) and B200 (B200 is x86_64, not arm64).
#
# Base provides torch, vllm, CUDA 13 toolkit, cuDNN, transformers, and Python 3.12.
# We only layer the verl source + a few Python deps + flash-attn + flashinfer.
#
# Build:
#   docker build -f docker/Dockerfile.self_evolving \
#       -t ddvd233/verl-selfevolving:cu130 \
#       --build-arg MIRL_REF=self_evolving_medical \
#       .
#
# Run (single-GPU smoke):
#   docker run --gpus '"device=0"' --rm -it --shm-size=8g \
#       -e HF_TOKEN=$HF_TOKEN \
#       -v $HOME/.cache/huggingface:/root/.cache/huggingface \
#       -v $HOME/scratch:/scratch \
#       ddvd233/verl-selfevolving:cu130 bash

ARG BASE_IMAGE=vllm/vllm-openai:gemma4-0505-x86_64_cu130
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1

# Minimal apt additions on top of the vllm base: git for clone, build tools for
# flash-attn compile. Everything else (CUDA toolkit, cuDNN, Python) is already
# present.
RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        build-essential \
        ninja-build \
    && rm -rf /var/lib/apt/lists/*

# Pull the self_evolving_medical branch. MIRL_REF can be a branch name or a
# pinned commit SHA; CACHEBUST is bumped to force a re-clone when the branch
# moves without changing the ref string.
WORKDIR /workspace
ARG MIRL_REPO=https://github.com/DDVD233/mirl
ARG MIRL_REF=self_evolving_medical
ARG CACHEBUST=1
RUN git clone --depth 50 --branch "${MIRL_REF}" "${MIRL_REPO}" verl \
    && cd verl \
    && echo "Cloned $(git rev-parse HEAD)"

WORKDIR /workspace/verl

# verl deps + self-evolving extras. Torch / vllm / transformers / Pillow are
# already in the base; pinning them here would just thrash.
RUN pip install -r requirements.txt \
    && pip install aiohttp httpx pymilvus nltk qwen-vl-utils

# Flash-attention 2 — compiled from source against the base image's torch.
ARG FLASH_ATTN_MAX_JOBS=32
RUN FLASH_ATTENTION_FORCE_BUILD=TRUE \
    MAX_JOBS=${FLASH_ATTN_MAX_JOBS} \
    pip install flash-attn --no-build-isolation --no-binary flash-attn

# FlashInfer (cu130 wheels).
RUN pip install 'flashinfer-python[cu13]' \
    && pip install flashinfer-jit-cache --index-url https://flashinfer.ai/whl/cu130

# verl/requirements.txt pins numpy<2.0.0 which forces 1.x. Newer torch + vllm
# work on numpy 2.x and several reward-side libs (e.g. gemma-4 pieces) expect
# it. Upgrade after the constrained install so we end up on numpy 2.x.
RUN pip install -U numpy

# Latest transformers — the base image's version may lag behind the Qwen3.5
# / Qwen3.6 / Gemma 4 dense models we're training and judging against.
RUN pip install -U transformers

# Megatron-LM core + Megatron-Bridge (NeMo). Megatron is optional for the
# self-evolving pipeline (which uses FSDP2), but we bundle it so the same
# image can run Megatron-strategy training and Gemma 4 conversions via
# Megatron-Bridge.
RUN pip install --no-deps git+https://github.com/NVIDIA/Megatron-LM.git@core_v0.16.0
RUN pip install -U git+https://github.com/NVIDIA-NeMo/Megatron-Bridge.git

# Verl is consumed as a source checkout (no pip install verl, per project
# convention). PYTHONPATH lets `python -m verl.trainer.main_ppo` run from any
# working directory.
ENV PYTHONPATH=/workspace/verl:${PYTHONPATH:-}

# Pre-fetch NLTK corpora used by the reward function's char_bleu so the first
# reward call doesn't try to download.
RUN python -c "import nltk; nltk.download('punkt_tab', quiet=True); nltk.download('punkt', quiet=True)" || true

WORKDIR /workspace/verl
CMD ["bash"]
